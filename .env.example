# Config validation only; the paper engine has a separate explicit CLI.
# Blank credentials are intentional. Never paste secrets into Git or chat.
RUN_MODE=shadow
ENABLE_LIVE_TRADING=false
# All live requests remain blocked until the later account/risk/T10 gates exist.
WALLEX_BASE_URL=https://api.wallex.ir
WALLEX_API_KEY=
SUB_ACCOUNT_CLIENT_ID=
# Operational subset of eligible account spot symbols; cannot override the denylist.
# See config/wallex-credit-market-policy.json; empty means no live trading.
WALLEX_ALLOWED_MARKETS=
# Default provider; approved alternatives require their exact origin/model binding.
# See docs/model-provider-evaluation.md. No automatic provider fallback.
LLM_PROVIDER=boxapi
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_MODEL=gpt-6-luna
# Used by scripts/probe_model.py. Fill only in local .env, never in this example.
BOXAPI_API_KEY=
DEVORA_API_KEY=
DAHL_API_KEY=
RIVER_API_KEY=
APMIX_API_KEY=
CODECRAFT_API_KEY=
# Explicit non-negative budgets are required before paid model experiments.
LLM_TOKEN_BUDGET=6000000
LLM_COST_BUDGET=2.40
LLM_COST_CURRENCY=USD
# End time confirmed by Pouria; finalization start is still a team policy choice.
CHALLENGE_END_AT=2026-10-23T23:50:00+03:30
FINALIZE_START_AT=
# Persistent disk on a server; local ignored paths during development.
STATE_DB_PATH=data/state.sqlite3
ARTIFACTS_DIR=artifacts
